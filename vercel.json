{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/index.ts"
    },
    "dazzling-collections": {
      "root": "artifacts/dazzling-collections",
      "framework": "vite",
      "buildCommand": "PORT=5173 BASE_PATH=/ pnpm run build",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "PORT=5174 BASE_PATH=/ pnpm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "dazzling-collections"
      }
    }
  ]
}
